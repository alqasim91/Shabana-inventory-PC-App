{
  "_templates": [
    {
      "key": "TABLE.showingCount",
      "params": [
        "shown",
        "total"
      ],
      "source": "showingCount: (shown: number, total: number) =>\n    `عرض ${shown.toLocaleString('ar-EG')} من ${total.toLocaleString('ar-EG')}`"
    },
    {
      "key": "SEARCH.moreSuffix",
      "params": [
        "n"
      ],
      "source": "moreSuffix: (n: number) => `و${n.toLocaleString('ar-EG')} نتيجة أخرى`"
    },
    {
      "key": "OPENING.confirm",
      "params": [
        "n"
      ],
      "source": "confirm: (n: number) => `سيتم تعديل رصيد ${n.toLocaleString('ar-EG')} صنف. متابعة؟`"
    },
    {
      "key": "OPENING.success",
      "params": [
        "n"
      ],
      "source": "success: (n: number) => `تم ضبط رصيد ${n.toLocaleString('ar-EG')} صنف`"
    },
    {
      "key": "PAYMENTS.overpayConfirm",
      "params": [
        "excess",
        "name"
      ],
      "source": "overpayConfirm: (excess: string, name: string) =>\n    `المبلغ يتجاوز المتبقي على الأمر بمقدار ${excess}. سيتم سداد الأمر بالكامل، ويُضاف الفائض رصيدًا لحساب «${name}» يُستخدم في طلبات قادمة أو يُسترد لاحقًا. هل تريد المتابعة؟`"
    },
    {
      "key": "PAYMENTS.overpaid",
      "params": [
        "excess"
      ],
      "source": "overpaid: (excess: string) => `تم السداد وإضافة ${excess} إلى رصيد العميل`"
    },
    {
      "key": "PAYMENTS.overpayConfirmVendor",
      "params": [
        "excess",
        "name"
      ],
      "source": "overpayConfirmVendor: (excess: string, name: string) =>\n    `المبلغ يتجاوز المتبقي على الأمر بمقدار ${excess}. سيتم سداد الأمر بالكامل، ويُسجَّل الفائض دفعةً مقدّمةً لدى «${name}» تُخصم من أوامر شراء قادمة أو تُسترد لاحقًا. هل تريد المتابعة؟`"
    },
    {
      "key": "PAYMENTS.overpaidVendor",
      "params": [
        "excess"
      ],
      "source": "overpaidVendor: (excess: string) => `تم السداد وتسجيل ${excess} كدفعة مقدّمة للمورّد`"
    },
    {
      "key": "CONTACT_OPENING.confirmSet",
      "params": [
        "amount",
        "kind"
      ],
      "source": "confirmSet: (amount: string, kind: string) => `سيتم تعيين \"${kind}\" على ${amount}. متابعة؟`"
    },
    {
      "key": "FINANCIALS.netSalesDetail",
      "params": [
        "gross",
        "discount"
      ],
      "source": "netSalesDetail: (gross: string, discount: string) => `قبل الخصم ${gross} · خصومات ${discount}`"
    },
    {
      "key": "EXPENSES.voidedBadge",
      "params": [
        "reason"
      ],
      "source": "voidedBadge: (reason: string) => `مُلغى — ${reason}`"
    },
    {
      "key": "EXPENSES.freqSummaryWeekly",
      "params": [
        "day"
      ],
      "source": "freqSummaryWeekly: (day: string) => `كل ${day}`"
    },
    {
      "key": "EXPENSES.freqSummaryMonthly",
      "params": [
        "day"
      ],
      "source": "freqSummaryMonthly: (day: number) => `يوم ${day.toLocaleString('ar-EG')} من كل شهر`"
    },
    {
      "key": "EXPENSES.dueCount",
      "params": [
        "n"
      ],
      "source": "dueCount: (n: number) => `${n.toLocaleString('ar-EG')} مصروف مستحق`"
    },
    {
      "key": "EXPENSES.dueBannerTitle",
      "params": [
        "n"
      ],
      "variants": [
        {
          "when": "n == 1",
          "text": "مصروف متكرر مستحق"
        }
      ],
      "source": "dueBannerTitle: (n: number) =>\n    n === 1 ? 'مصروف متكرر مستحق' : `${n.toLocaleString('ar-EG')} مصروفات متكررة مستحقة`"
    },
    {
      "key": "EXPENSES.dueLate",
      "params": [
        "days"
      ],
      "source": "dueLate: (days: number) => `متأخر ${days.toLocaleString('ar-EG')} يوم`"
    }
  ],
