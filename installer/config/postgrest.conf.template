# Generated by provision.ps1 / generate-secrets.ps1. Per-machine.

db-uri = "postgres://authenticator:{{DB_PASSWORD}}@localhost:{{PG_PORT}}/postgres"
db-schemas = "public"
db-anon-role = "anon"

# No jwt-aud: the anon and service_role keys generate-secrets.ps1 mints carry
# no `aud` claim (matching how Supabase's own anon/service keys look), while
# GoTrue's user tokens carry aud=authenticated. Setting jwt-aud here would make
# PostgREST reject any token whose aud doesn't match — silently breaking the
# anon key, and with it the app's ability to load at all. Every token in this
# stack targets this one PostgREST, so auditing the audience buys nothing.
jwt-secret = "{{JWT_SECRET}}"

server-host = "127.0.0.1"
server-port = {{POSTGREST_PORT}}

db-pool = 10
db-pool-timeout = 10
