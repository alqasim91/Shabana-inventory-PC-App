# Generated by provision.ps1 / generate-secrets.ps1. Per-machine — never
# copy this file between installs.

GOTRUE_SITE_URL=http://localhost:{{HTTP_PORT}}
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_DB_DRIVER=postgres
DATABASE_URL=postgres://supabase_auth_admin:{{DB_PASSWORD}}@localhost:{{PG_PORT}}/postgres

GOTRUE_JWT_SECRET={{JWT_SECRET}}
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

# No SMTP on a shop PC with no guaranteed internet. Every account is
# created directly by admin_set_user_access() / the first-run setup screen,
# never via email confirmation or email-based password reset. Password
# reset for a locked-out admin is installer/scripts/reset-admin.ps1, run
# locally with physical access to this machine — that IS the security
# model for recovery here.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=true

GOTRUE_API_HOST=127.0.0.1
GOTRUE_API_PORT={{GOTRUE_PORT}}
