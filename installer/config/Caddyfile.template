# Generated from this template by provision.ps1 - do not edit the installed
# copy directly, edit here and re-run provisioning, or your changes are lost
# on the next upgrade.

{
	admin off

	# Caddy never terminates TLS in this design. Locally it is plain HTTP on
	# loopback/LAN; over the public link Tailscale Funnel terminates TLS with
	# its own certificate and hands us plain HTTP.
	#
	# This line is load-bearing, not tidiness. Caddy 2.11 can issue
	# certificates for IP addresses, so the moment a site block was added for
	# `127.0.0.1:<port>` it started certificate management, blocked trying to
	# reach an ACME CA on a machine with no public DNS, and never got as far as
	# "serving initial configuration" - the service sat there and every request
	# to /auth/v1/health went unanswered, which reads exactly like GoTrue being
	# broken. Nothing here should ever ask for a certificate.
	auto_https off
}

:{{HTTP_PORT}} {
	# Static frontend build. The Supabase URL/anon key baked into these files
	# are per-machine, patched in place at install time by
	# patch-frontend-config.ps1 - see that script and BUILD_PLAN.md, "Why not
	# build-time secrets." No runtime-config endpoint needed: the values are
	# already literal strings in the JS by the time Caddy serves it.
	root * {{INSTALL_DIR}}\www

	# --- First-run claim, loopback-only -------------------------------------
	# On a tunnelled install there is a window between "installed" and "owner
	# has set up the admin" where a remote visitor could try to claim the
	# machine. pc_first_run_bootstrap is already one-shot server-side (it
	# refuses once any org exists), but we ALSO restrict both the setup UI and
	# the claim RPC to 127.0.0.1 so a remote party can neither see the form nor
	# call the RPC directly (it lives at /rest/v1/rpc/..., not /setup - gating
	# only the UI would leave the RPC reachable). Defence in depth.
	#
	# These two handle blocks are BEFORE the generic /rest/v1 and SPA handlers
	# on purpose: Caddy evaluates handle blocks in source order, first match
	# wins, so the specific paths must precede the general ones.
	@firstRunRpc path /rest/v1/rpc/pc_first_run_bootstrap
	handle @firstRunRpc {
		@remoteRpc not remote_ip 127.0.0.1 ::1
		respond @remoteRpc "Not available remotely" 403
		uri strip_prefix /rest/v1
		reverse_proxy 127.0.0.1:{{POSTGREST_PORT}}
	}

	@setup path /setup /setup/*
	handle @setup {
		@remoteSetup not remote_ip 127.0.0.1 ::1
		respond @remoteSetup "Not available remotely" 403
		# /setup is a client-side route, not a file - serve the SPA shell and
		# let the router take over.
		rewrite * /index.html
		file_server
	}

	# --- API proxies --------------------------------------------------------
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy 127.0.0.1:{{POSTGREST_PORT}}
	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy 127.0.0.1:{{GOTRUE_PORT}}
	}

	# --- PC operational status (backup badge) ------------------------------
	# Small JSON files written by the maintenance scripts (e.g. backup.ps1 ->
	# last-backup.json), served read-only for the in-app status widgets. Lives
	# outside www\ so it survives upgrades that replace the frontend.
	handle /pc/* {
		uri strip_prefix /pc
		root * {{INSTALL_DIR}}\public
		file_server
	}

	# --- Static assets + SPA fallback --------------------------------------
	handle {
		try_files {path} /index.html
		file_server
	}
}

# ===========================================================================
# The public link (Tailscale Funnel) - see installer/scripts/setup-tunnel.ps1
# ===========================================================================
# A SECOND entrypoint, deliberately not the one above.
#
# Funnel terminates TLS on THIS machine (Tailscale's relays forward the stream
# by SNI without decrypting it) and then proxies plain HTTP to a local port.
# Which means every request arriving here has remote_ip 127.0.0.1 - the tunnel
# rewrote it. The `not remote_ip 127.0.0.1` guards on the port above would look
# at a visitor in another country and see localhost.
#
# So the tunnel gets its own site, with those routes refused OUTRIGHT. No IP
# test, nothing to spoof with an X-Forwarded-For header, and no way for a later
# edit to the main block to quietly widen what the internet can reach.
#
# Bound to 127.0.0.1 explicitly, so only the Tailscale process on this machine
# can connect. With no tunnel running, this port answers nobody.
http://127.0.0.1:{{TUNNEL_PORT}} {
	root * {{INSTALL_DIR}}\www

	# Claiming the install and the first-run screen are LOCAL-ONLY, forever.
	# pc_first_run_bootstrap is one-shot server-side too; this is the second
	# lock, not the only one.
	#
	# Inside a `handle`, NOT a bare `respond`. Caddy sorts directives by its own
	# order, not by the order they are written, and `respond` sorts AFTER
	# `handle` - so a bare respond here would lose to the SPA fallback below and
	# quietly serve /setup to the internet. `handle` blocks are mutually
	# exclusive and evaluated in source order, which is the only reason the
	# equivalent guards on the main site work.
	# A NAMED MATCHER, because `handle` takes exactly one path argument -
	# `handle /a /b /c { }` is a parse error, not a three-path match.
	@neverRemote path /setup /setup/* /rest/v1/rpc/pc_first_run_bootstrap
	handle @neverRemote {
		respond "Not available remotely" 403
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy 127.0.0.1:{{POSTGREST_PORT}}
	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy 127.0.0.1:{{GOTRUE_PORT}}
	}

	handle /pc/* {
		uri strip_prefix /pc
		root * {{INSTALL_DIR}}\public
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
